# PostgreSQL
DATABASE_URL="postgresql://botpol:botpol@localhost:5432/botpol?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Trading — live is disabled unless BOTH flags are explicitly true/LIVE.
# Local dashboard ignores these in favor of the npm script:
#   npm run dev       → PAPER (Start = virtual fills)
#   npm run dev:live  → LIVE  (Start = real placeOrder)
# Never enable live trading until paper trading and walk-forward backtests pass.
LIVE_TRADING_ENABLED=false
TRADING_MODE=PAPER

# Paper credentials (server-side only, never sent to the browser)
BINANCE_PAPER_API_KEY=
BINANCE_PAPER_API_SECRET=

# Live credentials — kept separate on purpose. Leave empty until paper + walk-forward pass.
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# Spot / underlying market data (public streams do not need a secret)
BINANCE_SPOT_REST_BASE_URL="https://api.binance.com"
BINANCE_SPOT_WS_BASE_URL="wss://stream.binance.com:9443"

# Prediction REST defaults to official SAPI host used by @binance/w3w-prediction
BINANCE_PREDICTION_REST_BASE_URL="https://api.binance.com"
BINANCE_PREDICTION_WSS_URL="wss://api.binance.com/sapi/wss"
BINANCE_PREDICTION_CHAIN_ID="56"
BINANCE_PREDICTION_WALLET_ADDRESS=
# Required for live placeOrder if listPredictionWallets cannot match the address.
BINANCE_PREDICTION_WALLET_ID=
# Official placeOrder accountType enum: SPOT | FUNDING
BINANCE_PREDICTION_ACCOUNT_TYPE=SPOT

# Collectors (Phase 2–3)
PREDICTION_MIN_REQUEST_INTERVAL_MS=4000
# Discovery still lists all categories; trading/collect keep BTC/ETH/BNB 5m, 15m, 1h & 1d Up/Down.
COLLECTOR_L1_CATEGORY=
COLLECTOR_POLL_INTERVAL_MS=60000
# Short-dated markets (5m / same-day sport) need frequent rediscovery
COLLECTOR_REST_DISCOVERY_INTERVAL_MS=60000
COLLECTOR_WS_PERSIST_MIN_INTERVAL_MS=1000
COLLECTOR_MAX_TOPICS=24
# Only trade markets that settle within this window (48h so 1d candles at open still fit).
COLLECTOR_MAX_TIME_TO_EXPIRY_SEC=172800
COLLECTOR_UNDERLYING_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT
COLLECTOR_ONCE=false
WS_STALE_MS=15000
WS_MAX_CONNECTION_MS=82800000
RAW_DATA_DIR=./data/raw
# PostgreSQL is the primary raw-ingest store. Files are only a bounded fallback by default.
RAW_FILE_PERSIST_MODE=fallback
RAW_FILE_MAX_TOTAL_BYTES=536870912
RAW_FILE_RETENTION_DAYS=2
RAW_FILE_CLEANUP_INTERVAL_MS=900000
RAW_FILE_MIN_FREE_BYTES=2147483648

# AWS (Phase 10). Images and ECS task defs hardcode LIVE_TRADING_ENABLED=false.
# Do not put secrets in Dockerfiles or committed tfvars.
AWS_S3_RAW_BUCKET=
# On ECS the collector mounts EFS at /data/raw

# Risk defaults (overridable later from the dashboard)
BANKROLL_USDT=1000
MAX_POSITION_PCT=2.5
MAX_SIMULTANEOUS_POSITIONS=5
MAX_DAILY_LOSS_PCT=3
MAX_DRAWDOWN_PCT=10
MAX_SLIPPAGE_BPS=1000
MAX_PRICE_IMPACT=0.05
MIN_LIQUIDITY_USDT=100
MIN_TIME_TO_EXPIRY_SEC=60
SAFETY_MARGIN=0.005
# Same as strategy maxBuyAsk. Live/Paper ENTER (including after a flip) cannot buy above this.
MAX_ENTRY_ASK=0.55

# Lock winners like 0.13→0.47 / 0.145→0.45. Runs on dashboard Start with paper/live.
TAKE_PROFIT_MARK=0.45
TAKE_PROFIT_MIN_DELTA=0.20
TAKE_PROFIT_MIN_TTE_SEC=30
# Cut losers: mark dropped 15¢ from entry, or an expensive entry fell through 0.25.
STOP_LOSS_DELTA=0.15
STOP_LOSS_MARK=0.25
# Minimum net edge 8%. Max 1 = no cap. Both are editable on the Strategies tab.
EDGE_MIN=0.08
EDGE_MAX=1

# Local Ollama (free, no API key). `ollama pull llama3.2` then leave this as-is.
# Cloud (OpenAI/Groq) only if you set LLM_API_KEY and a remote LLM_BASE_URL.
LLM_API_KEY=
LLM_BASE_URL="http://127.0.0.1:11434/v1"
LLM_MODEL="llama3.1:8b"
LLM_TIMEOUT_MS=8000
LLM_CACHE_MS=20000

# Live: opposite strategy signal closes the held leg; take-profit does not flip.
RISK_COOLDOWN_MS=900000
RISK_CONSECUTIVE_LOSSES=5

# Paper trading (Phase 7). Never sends Binance placeOrder.
PAPER_LOOP_INTERVAL_MS=5000
PAPER_IDEMPOTENCY_MS=5000

# Live record (no trading). Start/Stop from the dashboard.
RECORD_LOOP_INTERVAL_MS=2000

# Live execution (Phase 11). Idle unless BOTH live flags are on (npm run dev:live). Docker/ECS stay false.
LIVE_LOOP_INTERVAL_MS=5000
LIVE_IDEMPOTENCY_MS=5000
# Paper-style: opposite signal closes then re-enters the other side. AWS Redis may still hold independent — set this.
LIVE_BINARY_MODE=flip
# Local SUBMITTED with no venue row is released after this so flip is not stuck.
LIVE_INFLIGHT_STALE_MS=120000

# Logging
LOG_LEVEL=info
NODE_ENV=development
